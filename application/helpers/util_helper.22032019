 function gen_id_boid($channel_id,$type,$table,$region_id,$seq_date, $agrtype, $region_nameshort)
     {

         $id_generate_db = getlast_boid($channel_id,$type,$table, $region_nameshort) ;


         if (count($id_generate_db) != 0) {
             $last_id = ($id_generate_db['lastid'] + 1);
             //$id_separate = sprintf("%'.0$id_loop.d\n", $last_id);
         } else{
             $last_id = '1';
             insert_boid($region_id,$type,$last_id,$table);
         }

         $id = 'LB'.$region_nameshort.date('y', $seq_date).date('m', $seq_date).$last_id;


         update_boid($channel_id,$type,$last_id,$table);


         return trim($id);
     }

     function gen_id_invid($channel_id,$type,$table,$region_id,$seq_date, $agrtype, $region_nameshort)
        {
            $periode = date('Y', $seq_date).date('m', $seq_date);			
            $id_generate_db = getlast_invid($channel_id,$type,$table,$periode,$region_id);


            if (count($id_generate_db) != 0) {
                $last_id = ($id_generate_db['lastid'] + 1);
                //$id_separate = sprintf("%'.0$id_loop.d\n", $last_id);
            } else{
                $last_id = '1';
                insert_invid($region,$type,$last_id,$table,$periode,$region_id);
            }

            $id = 'INV'.'/'.$last_id.'/'.$region_nameshort.'/'.$agrtype.'/'.date('m', $seq_date).'/'.date('y', $seq_date);


            update_invid($channel_id,$type,$last_id,$table,$periode,$region_id);


            return trim($id);
        }
		
 function gen_id_loo($region,$type,$table,$r_id,$seq_date)
    {        

        $id_generate_db = getlast_looid($region,$type,$table) ;


        if (count($id_generate_db) != 0) {            
            $last_id = ($id_generate_db['lastid'] + 1);        
            //$id_separate = sprintf("%'.0$id_loop.d\n", $last_id);
        } else{
            $last_id = '1';
            insert_looid($region,$type,$last_id,$table);
        }

        $id = 'SMM'.'/'.$last_id.'/'.$type.'/'.$r_id.'/'.romanic_number(date('m', $seq_date), true).'-'.date('y', $seq_date);
         

        update_looid($region,$type,$last_id,$table);


        return trim($id);
    }

    function gen_id_agree($channel_no, $type, $table, $r_code, $channel, $seq_date)
    {        

        $id_generate_db = getlast_agreeid($r_code, $type, $channel, $table) ;

        if (count($id_generate_db) != 0) {            
            $last_id = ($id_generate_db['lastid'] + 1);
        } else{
            $last_id = '1';
            insert_agreeid($r_code, $type, $last_id, $channel, $table);
        }

		$_period = date('ym');

        $str_len = strlen($last_id);
        $str = substr('0000', 1, 4 - $str_len).$last_id;

        $id = $type.$r_code.$channel_no.$_period.$str;

        //echo $id;
        update_agreeid($r_code, $type, $last_id, $channel, $table);

        return trim($id);
    }

 	function is_image($path){

        $a = getimagesize($path);        

        $image_type = $a[2];

        if(in_array($image_type , array(IMAGETYPE_GIF , IMAGETYPE_JPEG ,IMAGETYPE_PNG , IMAGETYPE_BMP)))
        {
            return true;
        }
        return false;
    }

	function generate_id_string($channel,$type,$length,$table)
	{
		
		$id_generate_db = get_generate_last_id($channel,$type,$table) ;
		$last_id = ($id_generate_db['lastid'] + 1);
		$id_loop = $length ;  
		$id_nol = "0";
		$id_separate = sprintf("%'.0$id_loop.d\n", $last_id);  
		$id = $type . $id_separate ;
		 
		update_generate_last_id($channel,$type,$last_id,$table);
		return trim($id);
	}	
	

	function getlast_agreeid($r_code, $type, $channel, $table)
	{
		$CI =& get_instance();
		$CI->db->where('channel_id', $channel);
		$CI->db->where('region_id', $r_code);
		$CI->db->where('type', $type);
        $result = $CI->db->get($table);

        if ($result->num_rows() == 1) 
        {
            return $result->row_array();
        } 
        else 
        {
            return array();
        }
		
	}
	
	 
