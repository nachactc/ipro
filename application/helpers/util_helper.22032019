}
	
	 
  	function penyebut($nilai) {
		$nilai = abs($nilai);
		$huruf = array("", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh", "delapan", "sembilan", "sepuluh", "sebelas");
		$temp = "";
		if ($nilai < 12) {
			$temp = " ". $huruf[$nilai];
		} else if ($nilai <20) {
			$temp = penyebut($nilai - 10). " belas";
		} else if ($nilai < 100) {
			$temp = penyebut($nilai/10)." puluh". penyebut($nilai % 10);
		} else if ($nilai < 200) {
			$temp = " seratus" . penyebut($nilai - 100);
		} else if ($nilai < 1000) {
			$temp = penyebut($nilai/100) . " ratus" . penyebut($nilai % 100);
		} else if ($nilai < 2000) {
			$temp = " seribu" . penyebut($nilai - 1000);
		} else if ($nilai < 1000000) {
			$temp = penyebut($nilai/1000) . " ribu" . penyebut($nilai % 1000);
		} else if ($nilai < 1000000000) {
			$temp = penyebut($nilai/1000000) . " juta" . penyebut($nilai % 1000000);
		} else if ($nilai < 1000000000000) {
			$temp = penyebut($nilai/1000000000) . " milyar" . penyebut(fmod($nilai,1000000000));
		} else if ($nilai < 1000000000000000) {
			$temp = penyebut($nilai/1000000000000) . " trilyun" . penyebut(fmod($nilai,1000000000000));
		}     
		return $temp;
	}
 
	function terbilangangka($nilai) {
		if($nilai<0) {
			$hasil = "minus ". trim(penyebut($nilai));
		} else {
			$hasil = trim(penyebut($nilai));
		}     		
		return $hasil;
	}        
	 
	
function get_va($debt_no, $branch_id){

	$va = "";

	if ($debt_no != '') {

		$codeReg = substr($debt_no, 0, 1);		

		switch($codeReg){

			case "C": $codeVA = "7801"; $codeVA2 = "1"; break;
			case "A": $codeVA = "7802"; $codeVA2 = "2"; break;
			case "P": $codeVA = "7821"; $codeVA2 = "4"; break;
			case "G": $codeVA = "7801"; $codeVA2 = "1"; break;
			case "T": $codeVA = "7853"; $codeVA2 = "4"; break;
		}		

		if ($codeReg == "A" && $branch_id == '0000371') {
			$codeVA = "7876"; 
			$codeVA2 = "2";
		} 

		if (strlen($debt_no) >= 12) {
			$lendebtor = 3;

		} else {
			$lendebtor = 2;
		}

		$codeStore = substr($debt_no, strrpos($debt_no, "-" ) +1, $lendebtor);

		if (strlen($codeStore) == 2) {

			$codeStore = "0" . $codeStore;
		}

		$codeDebtor = "0" . substr($debt_no, 1, 7);

		$va = $codeVA.$codeStore.$codeVA2.$codeDebtor;		
	}

	return $va;
}

function getIndoBulan($bln){
    switch ($bln) {
        case 1: 
            return "Januari";
            break;
        case 2:
            return "Februari";
            break;
        case 3:
            return "Maret";
            break;
        case 4:
            return "April";
            break;
        case 5:
            return "Mei";
            break;
        case 6:
            return "Juni";
            break;
        case 7:
            return "Juli";
            break;
        case 8:
            return "Agustus";
            break;
        case 9:
            return "September";
            break;
        case 10:
            return "Oktober";
            break;
        case 11:
            return "November";
            break;
        case 12:
            return "Desember";
            break;
    }
} 
 
function getIndoHari($date) {
    $temp_date = explode("-", $date); 
    $bulan   = getIndoBulan($temp_date[1]);
    $tahun  = $temp_date[0];
    $tanggal = $temp_date[2];
    $new_date = $tanggal." ".$bulan." ".$tahun;

    return $new_date;
}

function GetDataFromTable($tbl, $colid, $colname, $id)
{
	$field = '';
	$CI =& get_instance();
	$CI->db->where($colid, $id);
    $result = $CI->db->get($tbl);

    if ($result->num_rows() == 1)
    {
    	$row = $result->row_array();
    	if (isset($row))
		{
        	$field = $row[$colname];        
		}
    	return $field;        
    }

}

